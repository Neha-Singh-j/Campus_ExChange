PORT=5000
MONGODB_URI=mongodb://localhost:27017/campuszon
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Optional: token lifetime in seconds (default 7 days)
# JWT_EXPIRES_SECONDS=604800
# Optional: only allow .edu emails to sign up
# REQUIRE_EDU_EMAIL=true

# --- Admin account (created on server start) ---
# Choose your own; weak/placeholder passwords are refused. Never commit the real .env file.
ADMIN_EMAIL=admin@yourcampus.edu
ADMIN_PASSWORD=

# --- AI chatbot (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey . Without it the chatbot gives basic canned answers.
GEMINI_API_KEY=
# Optional: model to use (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Only for Vertex AI (Google Cloud) keys; AI Studio keys do not need this
# GEMINI_PROVIDER=vertex
