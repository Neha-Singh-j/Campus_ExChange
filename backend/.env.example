# ---- Server ----
PORT=5000
NODE_ENV=development
# Public URL of this API (used to build links to locally-stored images)
PUBLIC_URL=http://localhost:5000
# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (MongoDB is required) ----
MONGODB_URI=mongodb://localhost:27017/campus-exchange

# ---- Campus ----
CAMPUS_ID=gla
# Only emails ending in these domains (or their subdomains) can register
ALLOWED_EMAIL_DOMAINS=gla.ac.in

# ---- Auth ----
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Email (optional: only for offer / watchlist notifications; sign-up does NOT need email) ----
# Option A (free, recommended): Brevo API - https://www.brevo.com (about 300 emails/day free)
#   1) create an account  2) Senders: add + verify the sender email  3) SMTP & API > API Keys > create key
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Campus Exchange
# Option B: any SMTP server (Gmail app password, etc.)
# Leave everything empty to skip emails (they are just printed in the server console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Exchange <no-reply@yourdomain.com>"

# ---- Image uploads ----
# Option 1: Cloudinary (recommended for deployment). Set CLOUDINARY_URL
# or the three variables below. If none are set, images are stored in ./uploads.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seed script ----
SEED_PASSWORD=Demo@12345
